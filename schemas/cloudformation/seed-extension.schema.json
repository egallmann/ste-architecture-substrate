{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ste-architecture-substrate.local/schemas/cloudformation/seed-extension.schema.json",
  "title": "CloudFormation seed extension",
  "description": "Technology-specific namespace for CloudFormation seeds. Validate together with ../seed.schema.json via allOf.",
  "type": "object",
  "required": ["cloudformation"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["technology"],
      "properties": {
        "technology": {
          "type": "string",
          "const": "cloudformation"
        }
      }
    },
    "cloudformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates"],
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered CloudFormation templates that comprise this seed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Path relative to the seed directory root."
              },
              "description": {
                "type": "string"
              },
              "stack_name_pattern": {
                "type": "string",
                "description": "Optional deploy naming hint (not enforced by substrate)."
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "description": "Optional mirror or overlay of CloudFormation Parameters metadata for authoring UX.",
          "additionalProperties": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CAPABILITY_[A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "stack_policy": {
          "type": "string",
          "description": "Optional relative path to stack policy JSON."
        }
      }
    }
  }
}
