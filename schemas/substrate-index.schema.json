{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ste-architecture-substrate.local/schemas/substrate-index.schema.json",
  "title": "Substrate discovery index (substrate-index.json)",
  "description": "Machine-readable discovery bundle produced by substrate compile (ADR-PC-0008). Field names align with generator output; additional properties allowed for forward compatibility.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "generated_at"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Document format version."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "total_seeds": {
          "type": "integer",
          "minimum": 0
        },
        "total_bundles": {
          "type": "integer",
          "minimum": 0
        },
        "total_primitives": {
          "type": "integer",
          "minimum": 0
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
